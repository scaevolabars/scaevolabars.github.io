{{- /* Feeds: MathML only, since readers do not load the KaTeX CSS. */ -}}
{{- if and (eq .Type "inline") (ne .Inner (strings.TrimSpace .Inner)) }}
  {{- errorf "%s: inline math starts or ends with a space: %q. For a dollar sign, write \\$." .Position .Inner }}
{{- end }}
{{- $opts := dict "output" "mathml" "displayMode" (eq .Type "block") }}
{{- with try (transform.ToMath .Inner $opts) }}
  {{- with .Err }}
    {{- errorf "Unable to render math at %s: %s" $.Position . }}
  {{- else }}
    {{- .Value }}
  {{- end }}
{{- end -}}
